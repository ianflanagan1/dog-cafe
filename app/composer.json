{
    "name": "ianf/dog-cafe",
    "type": "project",
    "require": {
        "php": "^8.5",
        "psr/simple-cache": "^3",
        "psr/container": "^2.0",
        "google/apiclient": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "laravel/pint": "^1.32",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "ianflanagan1/phpstan-inferable-var-tag-name": "dev-main",
        "ianflanagan1/phpstan-redundant-inherited-phpdoc": "dev-main",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "shipmonk/phpstan-rules": "^4.4",
        "shipmonk/dead-code-detector": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config/pathConstants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/check-vendor-disabled-functions.php"
        ],
        "post-update-cmd": [
            "@php scripts/check-vendor-disabled-functions.php"
        ]
    }
}
