includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/shipmonk/phpstan-rules/rules.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
    - vendor/ianflanagan1/phpstan-inferable-var-tag-name/rules.neon
    - vendor/ianflanagan1/phpstan-redundant-inherited-phpdoc/rules.neon

parameters:
    level: 10           # 0-10
    checkMissingOverrideMethodAttribute: true
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    checkDynamicProperties: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportAlwaysTrueInLastCondition: true
    reportWrongPhpDocTypeInVarTag: true
    reportAnyTypeWideningInVarTag: true
    checkStrictPrintfPlaceholderTypes: true
    rememberPossiblyImpureFunctionValues: false
    # No outside callers, so a public signature wider than its implementation is just imprecise
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideParameterOutInProtectedAndPublicMethods: true

    # Exceptions are never checked. Expected failures, the ones some caller should decide on, are
    # returned as sentinels (?T) or Result objects, which level 10 forces callers to handle;
    # Result-returning functions carry #[\NoDiscard]. Every throw is meant to reach
    # RouteExceptionHandler (or the vendor-boundary catch that translates it), so @throws tags
    # would only say "this can fail" everywhere. Hence:
    # exceptions:
    #     check:
    #         missingCheckedExceptionInThrows: true
    #         tooWideThrowType: true

    shipmonkRules:
        # Both assume checked exceptions exist; here none do (see the exceptions note above)
        forbidCheckedExceptionInCallable:
            enabled: false
        forbidCheckedExceptionInYieldingMethod:
            enabled: false
    # Also report overrides that are only possibly incompatible, e.g. narrowing an inherited string param to non-empty-string in PHPDoc
    reportMaybesInMethodSignatures: true
    reportStaticMethodSignatures: true
    errorFormat: table  # raw table checkstyle json prettyJson junit github gitlab teamcity
    paths:
        - src
        - config
        - public
        - scripts
        - tests
    # excluding static/ vendor/

    # spaze/phpstan-disallowed-calls
    # Extends its disallowed-insecure-calls.neon, which only covers rand(), mt_rand(), lcg_value() and uniqid()
    disallowedFunctionCalls:
        -
            function:
                - 'srand()'
                - 'mt_srand()'
                - 'mt_getrandmax()'
                - 'getrandmax()'
                - 'str_shuffle()'
                - 'shuffle()'
                - 'array_rand()'
            message: 'it uses the predictable Mt19937 generator; use Random\Randomizer (secure by default) or random_bytes()'
        # COUPLED:disabled-functions. ⊇ php.ini:disable_functions (deploy/php/php.ini); same order, so the two lists diff cleanly
        # Applies to tests/ too: a test that needs one (php.phpunit.ini's exceptions) ignores it inline with a reason,
        # except ini_set(), which ignoreErrors allows throughout tests/
        -
            function:
                - 'exec()'
                - 'passthru()'
                - 'pcntl_exec()'
                - 'pcntl_fork()'
                - 'pclose()'
                - 'popen()'
                - 'proc_close()'
                - 'proc_get_status()'
                - 'proc_nice()'
                - 'proc_open()'
                - 'proc_terminate()'
                - 'shell_exec()'
                - 'system()'
                - 'mail()'
                - 'dl()'
                - 'putenv()'
                - 'ini_alter()'
                - 'ini_restore()'
                - 'ini_set()'
                - 'set_time_limit()'
                - 'posix_initgroups()'
                - 'posix_kill()'
                - 'posix_mkfifo()'
                - 'posix_setegid()'
                - 'posix_seteuid()'
                - 'posix_setgid()'
                - 'posix_setpgid()'
                - 'posix_setrlimit()'
                - 'posix_setsid()'
                - 'posix_setuid()'
                - 'fsockopen()'
                - 'pfsockopen()'
                - 'socket_accept()'
                - 'socket_bind()'
                - 'socket_connect()'
                - 'socket_create()'
                - 'socket_create_listen()'
                - 'socket_create_pair()'
                - 'socket_listen()'
                - 'socket_read()'
                - 'socket_recv()'
                - 'socket_select()'
                - 'socket_send()'
                - 'socket_write()'
                - 'stream_socket_client()'
                - 'stream_socket_server()'
                - 'chdir()'
                - 'chgrp()'
                - 'chown()'
                - 'lchgrp()'
                - 'lchown()'
                - 'link()'
                - 'move_uploaded_file()'
                - 'symlink()'
                - 'posix_mknod()'
                - 'disk_free_space()'
                - 'disk_total_space()'
                - 'get_current_user()'
                - 'getmygid()'
                - 'getmyinode()'
                - 'getmyuid()'
                - 'highlight_file()'
                - 'ini_get_all()'
                - 'openlog()'
                - 'parse_ini_file()'
                - 'phpcredits()'
                - 'phpinfo()'
                - 'php_uname()'
                - 'posix_ctermid()'
                - 'posix_getcwd()'
                - 'posix_getegid()'
                - 'posix_geteuid()'
                - 'posix_getgid()'
                - 'posix_getgrgid()'
                - 'posix_getgrnam()'
                - 'posix_getgroups()'
                - 'posix_getlogin()'
                - 'posix_getpgrp()'
                - 'posix_getppid()'
                - 'posix_getpwnam()'
                - 'posix_getpwuid()'
                - 'posix_getrlimit()'
                - 'posix_getsid()'
                - 'posix_getuid()'
                - 'posix_isatty()'
                - 'posix_times()'
                - 'posix_ttyname()'
                - 'show_source()'
                - 'xdebug_info()'
                - 'rand()'
                - 'mt_srand()'
                - 'srand()'
                - 'getrandmax()'
                - 'lcg_value()'
                - 'str_shuffle()'
                - 'shuffle()'
                - 'array_rand()'
                - 'extract()'
                - 'md5_file()'
                - 'sha1_file()'
            message: 'it is disabled in production (deploy/php/php.ini disable_functions)'

    ignoreErrors:
        # shipmonk/dead-code-detector can't see #[Get]/#[Post]/... routing, so every action looks unused
        -
            identifier: shipmonk.deadMethod
            path: src/Http/Controllers/*
        # Test fixtures exist to be reflected on (routing, autowiring), not called or read
        -
            identifier: shipmonk.deadMethod
            path: tests/*
        -
            identifier: shipmonk.deadProperty.neverRead
            path: tests/*
        # Tests may simulate configuration with ini_set() (in separate processes). App code may not: production disables it
        -
            identifier: disallowed.function
            path: tests/*
            message: '#^Calling ini_set\(\) is forbidden#'
            reportUnmatched: false
        # PSR-16 types $values as a bare iterable, which level 9 rejects as missing a value type, so it has to be restated
        -
            identifier: phpDoc.redundantInherited
            path: src/Framework/Cache/RedisCache.php
            message: '#\$values repeats the type inherited from Psr\\SimpleCache\\CacheInterface::setMultiple\(\)#'
