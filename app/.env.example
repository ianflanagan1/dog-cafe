APP_ENV=local
# COUPLED:dev-origin. = http://localhost:HTTP_PORT
APP_URL=http://localhost:8090

# Docker Compose (unique per worktree)
COMPOSE_PROJECT_NAME=dog-cafe
# COUPLED:dev-origin. localhost:HTTP_PORT must be registered in google-console, discord-portal and the Maps key referrers (docs/external/)
HTTP_PORT=8090

# Application Database
DB_CORE_DRIVER=pgsql
DB_CORE_PORT=5432
DB_CORE_HOST=dog-cafe-postgres
POSTGRES_DB=admin
POSTGRES_USER=admin
POSTGRES_PASSWORD=abcd1234

# Session cookie (app/config/session.php)
# COUPLED:public-domain. != app:config/session.php cookie_domain default (dev serves localhost; deliberate)
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# Cache
REDIS_HOST=dog-cafe-cache
REDIS_PORT=6379
REDIS_PASSWORD=abcd1234

# PHP
PHP_INI_DIR=/usr/local/etc/php

# Google OAuth login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Discord OAuth login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
